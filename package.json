{
  "name": "business-factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nx run-many -t build --all",
    "bff:environment": "tsx tools/bff-operator/src/main.ts",
    "boundaries:check": "node tools/verify-boundary-policy.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm boundaries:check && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm bundle:assert && pnpm secrets:scan && pnpm test:e2e",
    "convex:check": "nx run bff-service:typecheck",
    "convex:local": "convex dev --tail-logs disable",
    "format": "prettier --write --ignore-unknown \"{platform,tools}/**/*.{ts,tsx,css,html,json}\" \"*.{json,mjs,yaml,yml}\" \".github/**/*.yml\"",
    "format:check": "prettier --check --ignore-unknown \"{platform,tools}/**/*.{ts,tsx,css,html,json}\" \"*.{json,mjs,yaml,yml}\" \".github/**/*.yml\"",
    "lint": "nx run-many -t lint --all && eslint eslint.config.mjs tools/*.mjs --max-warnings 0",
    "production:build": "tsx --tsconfig tsconfig.base.json tools/production-delivery/src/build-dashboard.ts",
    "production:smoke": "tsx --tsconfig tsconfig.base.json tools/production-delivery/src/smoke.ts",
    "development-auth:keygen": "nx run bff-backoffice-e2e:generate-development-auth-key",
    "development-auth:build": "nx run bff-backoffice:build-development-auth",
    "secrets:scan": "secretlint \"**/*\"",
    "test": "nx run-many -t test --all",
    "test:e2e": "nx run bff-backoffice-e2e:e2e",
    "test:e2e:development-auth": "nx run bff-backoffice-e2e:e2e-hosted-development",
    "test:integration": "nx run bff-service:test-integration",
    "typecheck": "nx run-many -t typecheck --all",
    "bundle:assert": "nx run bff-backoffice:assert-production-bundle"
  },
  "dependencies": {
    "convex": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "5.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "convex-test": "0.0.60",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jose": "6.2.12",
    "jsdom": "30.1.1",
    "nx": "23.2.1",
    "prettier": "3.9.9",
    "secretlint": "13.0.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.141.0"
  }
}
