{
  "name": "bff-operator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/bff-operator/src",
  "projectType": "application",
  "tags": ["scope:operator", "type:tool"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tools/bff-operator/tsconfig.build.json"
      },
      "outputs": ["{workspaceRoot}/dist/tools/bff-operator"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint tools/bff-operator --max-warnings 0"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config tools/bff-operator/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tools/bff-operator/tsconfig.json --noEmit"
      }
    }
  }
}
