{
  "name": "production-delivery",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/production-delivery/src",
  "projectType": "application",
  "tags": ["scope:operator", "type:tool"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tools/production-delivery/tsconfig.build.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint tools/production-delivery --max-warnings 0"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config tools/production-delivery/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tools/production-delivery/tsconfig.json --noEmit"
      }
    }
  }
}
