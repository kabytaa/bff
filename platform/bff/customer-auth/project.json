{
  "name": "bff-customer-auth",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "platform/bff/customer-auth/src",
  "projectType": "application",
  "tags": ["scope:bff", "type:app"],
  "targets": {
    "assert-production-bundle": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx platform/bff/customer-auth/scripts/assert-production-bundle.mjs"
      },
      "dependsOn": ["build"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config platform/bff/customer-auth/vite.config.ts"
      },
      "outputs": ["{workspaceRoot}/dist/platform/bff/customer-auth"]
    },
    "build-development": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config platform/bff/customer-auth/vite.development.config.ts"
      },
      "outputs": ["{workspaceRoot}/dist/platform/bff/customer-auth-development"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint platform/bff/customer-auth --max-warnings 0"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config platform/bff/customer-auth/vite.config.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config platform/bff/customer-auth/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p platform/bff/customer-auth/tsconfig.json --noEmit"
      }
    }
  }
}
