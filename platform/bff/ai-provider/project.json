{
  "name": "bff-ai-provider",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "platform/bff/ai-provider/src",
  "projectType": "application",
  "tags": ["scope:bff", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy --dry-run --config platform/bff/ai-provider/wrangler.jsonc --outdir dist/platform/bff/ai-provider"
      },
      "outputs": ["{workspaceRoot}/dist/platform/bff/ai-provider"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p platform/bff/ai-provider/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config platform/bff/ai-provider/vitest.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint platform/bff/ai-provider --max-warnings 0"
      }
    }
  }
}
