{
  "name": "bff-assistant",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "platform/bff/libs/assistant/src",
  "projectType": "library",
  "tags": ["scope:public", "type:library"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p platform/bff/libs/assistant/tsconfig.lib.json",
          "cp platform/bff/libs/assistant/src/styles.css platform/bff/libs/assistant/src/styles.css.d.ts dist/platform/bff/libs/assistant/"
        ],
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/dist/platform/bff/libs/assistant"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p platform/bff/libs/assistant/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config platform/bff/libs/assistant/vitest.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint platform/bff/libs/assistant --max-warnings 0"
      }
    }
  }
}
