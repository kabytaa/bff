{
  "name": "bff-static-config",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "platform/bff/libs/config/src",
  "projectType": "library",
  "tags": ["scope:bff", "type:config"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p platform/bff/libs/config/tsconfig.lib.json"
      },
      "outputs": ["{workspaceRoot}/dist/platform/bff/libs/config"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint platform/bff/libs/config --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p platform/bff/libs/config/tsconfig.json --noEmit"
      }
    }
  }
}
