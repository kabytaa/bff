{
  "name": "bff-customer-auth-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "platform/bff/customer-auth-e2e/src",
  "projectType": "application",
  "tags": ["scope:bff", "type:e2e"],
  "implicitDependencies": ["bff-sdk-typescript", "example-web"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PLAYWRIGHT_HTML_OPEN=never playwright test --config platform/bff/customer-auth-e2e/playwright.config.ts"
      }
    },
    "e2e-hosted-development": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "PLAYWRIGHT_HTML_OPEN=never playwright test --config platform/bff/customer-auth-e2e/playwright.hosted-development.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint platform/bff/customer-auth-e2e --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p platform/bff/customer-auth-e2e/tsconfig.json --noEmit"
      }
    }
  }
}
