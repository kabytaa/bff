{
  "name": "bff-backoffice",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "platform/bff/backoffice/src",
  "projectType": "application",
  "tags": ["scope:bff", "type:app"],
  "targets": {
    "assert-production-bundle": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node platform/bff/backoffice/scripts/assert-production-bundle.mjs"
      },
      "dependsOn": ["build"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config platform/bff/backoffice/vite.config.ts"
      },
      "outputs": ["{workspaceRoot}/dist/platform/bff/backoffice"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint platform/bff/backoffice --max-warnings 0"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config platform/bff/backoffice/vite.config.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config platform/bff/backoffice/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p platform/bff/backoffice/tsconfig.json --noEmit"
      }
    }
  }
}
