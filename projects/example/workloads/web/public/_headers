/*
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.convex.cloud https://*.convex.site https://*.tofler.tech; img-src 'self' https: data:; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
