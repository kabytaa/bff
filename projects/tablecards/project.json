{
  "name": "tablecards-operations",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "projects/tablecards/support",
  "projectType": "library",
  "tags": ["scope:business", "type:library"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint projects/tablecards/operator-work.defaults.ts projects/tablecards/support --max-warnings 0"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config projects/tablecards/support/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p projects/tablecards/support/tsconfig.json --noEmit"
      }
    }
  }
}
