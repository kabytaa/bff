{
  "name": "tablecards-session-gateway",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "projects/tablecards/session-gateway/src",
  "projectType": "application",
  "tags": ["scope:business", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "options": {
        "command": "wrangler deploy --dry-run --config projects/tablecards/session-gateway/wrangler.jsonc --var UPSTREAM_ORIGIN:https://example.invalid --var BUILD_VERSION:dry-run --outdir dist/projects/tablecards/session-gateway"
      },
      "outputs": ["{workspaceRoot}/dist/projects/tablecards/session-gateway"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint projects/tablecards/session-gateway --max-warnings 0"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config projects/tablecards/session-gateway/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p projects/tablecards/session-gateway/tsconfig.json --noEmit"
      }
    }
  }
}
